{
  "name": "kriah-listener",
  "version": "0.1.0",
  "private": true,
  "description": "A classroom Hebrew reading station that hears a child read and marks every letter and vowel.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drlevidruin/kriah-listener-entry"
  },
  "scripts": {
    "test": "node --test",
    "grade": "node grader/cli.js",
    "record": "node tools/clip-recorder/server.js",
    "ear-test": "node tools/clip-recorder/run-ear.js",
    "build:bank": "node bank/build.js",
    "check:page": "node bank/check-page.js",
    "test:station": "cd station && npx vitest run --configLoader native"
  }
}
