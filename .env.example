BASETEN_API_KEY=
META_API_KEY=
# Required: 4 to 12 digits. Invalid or missing values stop the server.
TEACHER_PIN=
TRACE=
COACH_MODEL=
COACH_REASONING_EFFORT=minimal
DATA_DIR=./data
EAR_PRIMARY_MODEL=meta-models/muse-spark-open-1026
EAR_FALLBACK_MODEL=muse-wonder-1.0
EAR_REASONING_EFFORT=minimal

# Browsers allow the microphone only on https or localhost.
# Network tablets need HOST=0.0.0.0 and both TLS paths. See README for a certificate.
# Localhost works without https. This has not been tested on a real tablet yet.
HOST=127.0.0.1
PORT=8787
# Paths to a PEM certificate and key. Set both for https; leave both empty for http.
# If only one path is set or either file cannot be read, startup stops.
TLS_CERT=
TLS_KEY=
