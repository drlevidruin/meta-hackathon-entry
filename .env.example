BASETEN_API_KEY=
META_API_KEY=
# Required: 4 to 12 digits. Invalid or missing values stop the server.
TEACHER_PIN=
TRACE=
COACH_MODEL=
COACH_REASONING_EFFORT=minimal
DATA_DIR=./data
EAR_PRIMARY_MODEL=meta-models/muse-spark-open-1026
EAR_FALLBACK_MODEL=muse-wonder-1.0
EAR_REASONING_EFFORT=minimal

# Browsers allow the microphone only on https or localhost. This server uses plain http.
# Network tablets need HOST=0.0.0.0 and an https address in front of the server.
# On the server computer, use http://localhost:8787. Tablet setup is untested.
HOST=127.0.0.1
PORT=8787
